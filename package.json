{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test worker/test/integration.test.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply we-bsite --remote --config worker/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply we-bsite --local --config worker/wrangler.jsonc",
    "db:prepare-import": "node scripts/prepare-d1-import.mjs",
    "db:upload-stamps": "node scripts/upload-stamps.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.2",
    "@radix-ui/react-icons": "^1.1.1",
    "dayjs": "^1.11.7",
    "framer-motion": "^8.0.2",
    "next": "16.3.1",
    "perfect-cursors": "^1.0.5",
    "randomcolor": "^0.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.5",
    "sass": "^1.55.0",
    "seedrandom": "^3.0.5",
    "y-indexeddb": "^9.0.9",
    "y-webrtc": "^10.2.3",
    "yjs": "^13.5.44",
    "zustand": "^4.2.0",
    "zustand-yjs": "^0.0.14"
  },
  "devDependencies": {
    "@types/node": "18.11.7",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "^18.0.22",
    "@types/react-dom": "^18.0.7",
    "@types/seedrandom": "^3.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^3.2.4",
    "typescript": "5.9.3",
    "wrangler": "^4.123.0"
  }
}
